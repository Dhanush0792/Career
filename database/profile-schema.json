{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobXApply Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["fullName"],
  "properties": {
    "id": { "type": "string" },
    "profileName": { "type": "string", "maxLength": 120 },
    "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "firstName": { "type": "string", "maxLength": 60 },
    "lastName": { "type": "string", "maxLength": 60 },
    "age": { "type": "integer", "minimum": 0, "maximum": 150 },
    "dob": { "type": "string", "format": "date" },
    "fatherName": { "type": "string", "maxLength": 120 },
    "motherName": { "type": "string", "maxLength": 120 },
    "email": { "type": "string", "format": "email" },
    "phone": { "type": "string", "maxLength": 40 },
    "address": { "type": "string", "maxLength": 400 },
    "city": { "type": "string", "maxLength": 120 },
    "state": { "type": "string", "maxLength": 120 },
    "country": { "type": "string", "maxLength": 120 },
    "zip": { "type": "string", "maxLength": 40 },
    "headline": { "type": "string", "maxLength": 160 },
    "summary": { "type": "string", "maxLength": 1200 },
    "education": { "type": "string", "maxLength": 2000 },
    "college": { "type": "string", "maxLength": 240 },
    "experience": { "type": "string", "maxLength": 4000 },
    "skills": { "type": "string", "maxLength": 2000 },
    "linkedin": { "type": "string", "maxLength": 280 },
    "github": { "type": "string", "maxLength": 280 },
    "portfolio": { "type": "string", "maxLength": 280 },
    "leetcode": { "type": "string", "maxLength": 280 },
    "phoneCode": { "type": "string", "maxLength": 10 },
    "availability": { "type": "string", "maxLength": 40 },
    "noticePeriod": { "type": "integer", "minimum": 0 },
    "totalExperience": { "type": "integer", "minimum": 0 },
    "edu10_school": { "type": "string", "maxLength": 240 },
    "edu10_board": { "type": "string", "maxLength": 120 },
    "edu10_year": { "type": "string", "maxLength": 10 },
    "edu10_cgpa": { "type": "string", "maxLength": 20 },
    "edu12_school": { "type": "string", "maxLength": 240 },
    "edu12_board": { "type": "string", "maxLength": 120 },
    "edu12_year": { "type": "string", "maxLength": 10 },
    "edu12_cgpa": { "type": "string", "maxLength": 20 },
    "eduGrad_college": { "type": "string", "maxLength": 240 },
    "eduGrad_degree": { "type": "string", "maxLength": 240 },
    "eduGrad_year": { "type": "string", "maxLength": 10 },
    "eduGrad_cgpa": { "type": "string", "maxLength": 20 },
    "eduGrad_pursuing": { "type": "boolean" },
    "eduPG_college": { "type": "string", "maxLength": 240 },
    "eduPG_degree": { "type": "string", "maxLength": 240 },
    "eduPG_year": { "type": "string", "maxLength": 10 },
    "eduPG_cgpa": { "type": "string", "maxLength": 20 },
    "eduPG_pursuing": { "type": "boolean" },
    "experienceList": { "type": "array" },
    "projectsList": { "type": "array" },
    "certificationsList": { "type": "array" },
    "resumeDraft": { "type": "string", "maxLength": 20000 },
    "targetRole": { "type": "string", "maxLength": 160 },
    "alternativeEmail": { "type": "string", "maxLength": 280 },
    "pincode": { "type": "string", "maxLength": 20 },
    "maritalStatus": { "type": "string", "maxLength": 60 },
    "employmentStatus": { "type": "string", "maxLength": 60 },
    "expectedSalary": { "type": "string", "maxLength": 60 },
    "handicapped": { "type": "string", "maxLength": 20 },
    "healthIssues": { "type": "string", "maxLength": 1000 },
    "targetRoles": { "type": "string", "maxLength": 1000 },
    "coverLetterDraft": { "type": "string", "maxLength": 20000 },
    "otherDocuments": { "type": "string", "maxLength": 4000 },
    "eduGrad_stream": { "type": "string", "maxLength": 120 },
    "eduPG_stream": { "type": "string", "maxLength": 120 },
    "eduMasters_college": { "type": "string", "maxLength": 240 },
    "eduMasters_degree": { "type": "string", "maxLength": 240 },
    "eduMasters_year": { "type": "string", "maxLength": 10 },
    "eduMasters_cgpa": { "type": "string", "maxLength": 20 },
    "eduMasters_pursuing": { "type": "boolean" },
    "eduPhD_college": { "type": "string", "maxLength": 240 },
    "eduPhD_degree": { "type": "string", "maxLength": 240 },
    "eduPhD_year": { "type": "string", "maxLength": 10 },
    "eduPhD_cgpa": { "type": "string", "maxLength": 20 },
    "eduPhD_pursuing": { "type": "boolean" },
    "encryptedBlob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ciphertext", "iv", "salt"],
      "properties": {
        "ciphertext": { "type": "string" },
        "iv": { "type": "string" },
        "salt": { "type": "string" }
      }
    }
  }
}
